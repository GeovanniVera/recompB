# Copy to .env (or export these variables) before running the backend.
# Never commit real secrets.

# --- Database (matches docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=miscalorias
DB_USER=mis_calorias
DB_PASSWORD=mis_calorias

# --- JWT (32+ bytes, generate with: openssl rand -base64 48) ---
APP_JWT_SECRET=dev-only-change-me-this-secret-has-more-than-32-bytes

# --- Telegram OTP delivery ---
# 1. Create a bot with @BotFather and copy the token.
# 2. Send any message to your bot from the account that must receive the codes.
# 3. Ask @userinfobot for your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Leave true for local development without a bot configured (OTP is logged).
TELEGRAM_FALLBACK_TO_LOG=true

# --- CORS ---
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200,http://127.0.0.1:4200
